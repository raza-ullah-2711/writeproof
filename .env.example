# Copy to .env and fill in. .env is git-ignored; never commit real values.
DB_NAME=writeproof
DB_USERNAME=writeproof
DB_PASSWORD=
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/writeproof

# Base64 HMAC key for signing access tokens (>= 32 bytes). Generate: openssl rand -base64 32
JWT_SECRET=

# Optional: minimum handwriting similarity score (0..1), default 0.5
# HANDWRITING_THRESHOLD=0.5

# Base64 AES-256 key encrypting stored handwriting at rest. Generate: openssl rand -base64 32
HANDWRITING_DATA_KEY=
# Base64 32-byte Ed25519 seed for the key that signs ledger checkpoints. Clients pin its public
# half: on a live server, change it only by rotating (docs/ledger.md). Generate: openssl rand -base64 32
# While rotating: LEDGER_PREVIOUS_SIGNING_KEY=<the key being retired>
LEDGER_SIGNING_KEY=
# Optional: LEDGER_CHECKPOINT_INTERVAL=PT10M, LEDGER_CHECKPOINT_LOG=/path/to/checkpoints.jsonl

# Optional: wallet addresses (comma-separated) that are always admins. Create your wallet in the
# app, copy its address from the Letters page, and put it here to reach /admin.
# ADMIN_PUBLIC_KEYS=

# Development only:
# HANDWRITING_EXPOSE_SCORES=true
# RATE_LIMITS_ENABLED=false
